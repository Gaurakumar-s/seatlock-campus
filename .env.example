# Docker Compose reads this file. Shell/JAR launchers use environment variables.
# Copy to .env; keep .env private. Never commit SMTP credentials.
DB_PASSWORD=change-this-local-database-password
MAIL_FROM=events@yourcollege.edu
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-app-password
# For direct local runs, MAIL_MODE=development needs no email provider.
# For real email delivery use MAIL_MODE=smtp. STARTTLS is required by default.
# Optional HTTPS transport for hosts that block SMTP ports:
# MAIL_MODE=smtp
# MAIL_TRANSPORT=brevo
# BREVO_API_KEY=configure-privately-in-the-hosting-dashboard
